rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isVerified() { return request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isSuperAdmin() {
      return isSignedIn() && (request.auth.token.email == 'alsrhyarslan5@gmail.com' || request.auth.token.email == 'arslan.alshamari@gmail.com');
    }

    function getUserRole() {
      // Allow read from users table if authenticated
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function hasRole(role) {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == role);
    }

    function hasAnyRole(roles) {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserRole() in roles));
    }

    // Role-based Access Levels
    // Level 1: Manage system (Admin, SuperAdmin)
    // Level 2: Manage operations (Employee) + Level 1
    // Level 3: Finance (Accountant) + Level 1
    // Level 4: Delivery (Courier)

    function canManageUsers() {
      return isSuperAdmin() || hasRole('Admin');
    }

    function canManageOperations() {
      return isSuperAdmin() || hasAnyRole(['Admin', 'Employee']);
    }

    function canViewFinancials() {
      return isSuperAdmin() || hasAnyRole(['Admin', 'Accountant']);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'fullName', 'role', 'createdAt']) &&
             data.email is string &&
             data.fullName is string &&
             data.role is string &&
             data.createdAt is number &&
             (!data.keys().hasAny(['systemPin']) || (data.systemPin is string && data.systemPin.size() >= 4));
    }

    match /roles/{roleId} {
      allow get: if isSignedIn();
      allow list: if canManageUsers();
      allow write: if canManageUsers();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() || (request.query.limit <= 1 && request.query.offset == 0);
      allow create: if canManageUsers() || (isSignedIn() && request.auth.uid == userId) || (!isSignedIn() && request.resource.data.email in ['alsrhyarslan5@gmail.com', 'arslan.alshamari@gmail.com']);
      allow update: if canManageUsers();
      allow delete: if canManageUsers();
    }

    match /couriers/{courierId} {
      allow read: if canManageOperations() || canViewFinancials();
      allow create, update, delete: if canManageOperations();
    }

    match /sources/{sourceId} {
      allow read: if canManageOperations() || hasRole('Accountant');
      allow create, update, delete: if canManageOperations() || hasRole('Accountant');
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['fullName', 'phone']) &&
             data.fullName is string && data.phone is string;
    }

    match /customers/{customerId} {
      allow read: if canManageOperations() || hasRole('Accountant');
      allow create: if canManageOperations() && isValidCustomer(incoming());
      allow update, delete: if canManageOperations();
    }

    match /payments/{paymentId} {
      allow read: if canViewFinancials();
      allow create, update, delete: if canManageOperations();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn();
      allow list: if canManageOperations() || canViewFinancials() || (hasRole('Courier') && (existing().get('delivery_courier_id', '') == request.auth.uid || existing().get('shipping_courier_id', '') == request.auth.uid));
      allow create, update, delete: if canManageOperations();
      allow update: if (hasRole('Courier') && 
                      (existing().get('delivery_courier_id', '') == request.auth.uid || existing().get('shipping_courier_id', '') == request.auth.uid) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['order_status', 'delivery_status', 'notes', 'paid_amount', 'remaining_amount', 'payment_status', 'updatedAt'])
                     );

      match /items/{itemId} {
        allow read: if isSignedIn();
        allow write: if canManageOperations();
      }

      match /shippings/{shippingId} {
        allow read: if isSignedIn();
        allow write: if canManageOperations();
      }

      match /trackingUpdates/{updateId} {
        allow read: if isSignedIn();
        allow create: if canManageOperations() || hasRole('Courier');
        allow update, delete: if false;
      }
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if canManageUsers();
    }
    
    match /notifications/{docId} {
      allow read: if isSignedIn() && (existing() == null || existing().get('userId', request.auth.uid) == request.auth.uid || existing().get('userId', 'global') == 'global');
      allow write: if canManageOperations();
    }

    match /public_tracking/{trackingNumber} {
      allow get: if true;
      allow list: if false;
      allow create: if canManageOperations();
      allow update: if canManageOperations() || hasRole('Courier');
      allow delete: if canManageUsers();
    }
  }
}

